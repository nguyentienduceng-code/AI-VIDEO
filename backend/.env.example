
# ─────────────────────────────────────────
# AI VIDEO MAKER — Backend Environment
# ─────────────────────────────────────────
# Lấy API Key miễn phí tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=
PEXELS_API_KEY=

# Cổng chạy Backend (mặc định: 8000)
PORT=8000

# Các origin được phép gọi API. Để TRỐNG = chỉ localhost:3001 và localhost:5173 (đủ cho
# start.bat). Backend này có endpoint đổi thư mục lưu trữ và xoá cache, nên KHÔNG nên để
# "*" — mọi website đang mở trong trình duyệt đều gọi được chúng.
# Mở UI từ máy khác trong mạng LAN thì thêm origin đó vào, phân tách bằng dấu phẩy:
#   ALLOWED_ORIGINS=http://localhost:3001,http://192.168.1.50:3001
ALLOWED_ORIGINS=

# ─────────────────────────────────────────
# Thư mục lưu trữ
# ─────────────────────────────────────────
# Nơi đổ MỌI dữ liệu do chạy máy sinh ra: ảnh, video thành phẩm, cache, audio, uploads.
# Để trống = backend/assets (ổ C, mặc định như cũ).
# Trỏ sang ổ khác để khỏi làm đầy SSD hệ thống — phải là đường dẫn TUYỆT ĐỐI:
#   CUSTOM_ASSETS_DIR=D:\AIVideoAssets
# Lưu ý: nhạc nền (assets/bgm) và tiếng động (assets/sfx) LUÔN ở cùng mã nguồn, không
# di dời — xem backend/config.py. Đổi giá trị này phải khởi động lại backend.
CUSTOM_ASSETS_DIR=

# Giọng đọc mặc định (Edge TTS)
# Nữ: vi-VN-HoaiMyNeural | Nam: vi-VN-NamMinhNeural
TTS_VOICE=vi-VN-HoaiMyNeural
